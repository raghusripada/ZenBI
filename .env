# Environment variables for ZenBI

# CRITICAL: Replace "your_openai_api_key_here" with your actual OpenAI API Key
# if you intend to use LLM-based features.
OPENAI_API_KEY="your_openai_api_key_here"

# --- OpenMetadata Configuration (Optional) ---
# If you want to use OpenMetadata integration, uncomment and configure these variables.
# OM_SERVER_URL="http://localhost:8585/api"
# OM_AUTH_PROVIDER="no-auth" # Options: "no-auth", "openmetadata", "google"

# For "openmetadata" auth provider:
# OM_JWT_TOKEN="your_openmetadata_jwt_token"

# For "google" auth provider (refer to OpenMetadata documentation for details):
# OM_SECRET_KEY="path_to_your_google_secret_key.json"
# OR if using Google IdP with a custom audience for service accounts
# OM_GOOGLE_CREDENTIALS_PATH="your_google_audience_url_or_path_to_credentials_json"
